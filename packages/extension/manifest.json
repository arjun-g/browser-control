{
  "manifest_version": 3,
  "name": "Browser Control Bridge",
  "version": "0.1.0",
  "description": "Connects Chrome/Edge sessions to a local MCP bridge server.",
  "permissions": ["tabs", "scripting", "activeTab", "storage", "alarms", "debugger", "offscreen"],
  "host_permissions": ["<all_urls>", "ws://127.0.0.1/*", "ws://localhost/*"],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Browser Control Bridge"
  }
}
