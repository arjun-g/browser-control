{
  "name": "@browser-control/mcp-server",
  "version": "0.1.5",
  "description": "MCP server for controlling existing Chrome/Edge sessions via extension bridge",
  "license": "MIT",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "browser",
    "automation",
    "chrome",
    "edge"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "browser-control-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --import tsx test/**/*.test.ts",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@browser-control/shared": "0.1.0",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/ws": "^8.5.14",
    "tsx": "^4.20.3",
    "typescript": "^5.7.3"
  }
}
